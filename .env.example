# Copy this file to .env and adjust the values for your environment.
# All variables use the ASL_ prefix.

# ── Router ──────────────────────────────────────────────────────────
ASL_ROUTER_HOST=0.0.0.0
ASL_ROUTER_PORT=8000
ASL_ROUTER_WORKERS=4
ASL_ROUTER_REQUEST_TIMEOUT_SECONDS=30.0
ASL_ROUTER_MAX_PAYLOAD_BYTES=10485760
ASL_ROUTER_ENABLE_COMPRESSION=true
ASL_ROUTER_COMPRESSION_MIN_SIZE=4096

# ── Context Budget ───────────────────────────────────────────────────
ASL_CONTEXT_TOKEN_BUDGET=8192
ASL_CONTEXT_DISCLOSURE_LEVELS=3
ASL_CONTEXT_SUMMARY_RATIO=0.25
# Options: whitespace | char_approx | tiktoken
ASL_CONTEXT_TOKEN_COUNT_METHOD=char_approx

# ── Snapshot Engine ──────────────────────────────────────────────────
ASL_SNAPSHOT_DB_PATH=data/snapshots.db
ASL_SNAPSHOT_INTENT_DEVIATION_THRESHOLD=0.35
ASL_SNAPSHOT_MAX_ROLLBACK_DEPTH=10
ASL_SNAPSHOT_CHECKPOINT_INTERVAL_SECONDS=5.0
ASL_SNAPSHOT_COMPRESSION_ENABLED=true
ASL_SNAPSHOT_RETENTION_DAYS=7

# ── Docker Sandbox ───────────────────────────────────────────────────
ASL_SANDBOX_IMAGE=agent-state-ledger-sandbox:latest
ASL_SANDBOX_CPU_LIMIT=1.0
ASL_SANDBOX_MEMORY_LIMIT_MB=512
# Options: none | bridge | host  (none = maximum isolation)
ASL_SANDBOX_NETWORK_MODE=none
ASL_SANDBOX_EXECUTION_TIMEOUT_SECONDS=60
ASL_SANDBOX_READ_ONLY_ROOTFS=true

# ── Observability ────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
ASL_LOG_LEVEL=INFO
# Options: json | console  (use console for local dev)
ASL_LOG_FORMAT=json
ASL_METRICS_ENABLED=true
ASL_METRICS_PORT=9090
ASL_TRACE_HEADER=X-ASL-Trace-ID
